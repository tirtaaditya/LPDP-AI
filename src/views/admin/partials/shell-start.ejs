<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= pageTitle %> | AI LPDP Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link href="/public/css/admin.css" rel="stylesheet" />
  <link href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
</head>
<body class="app-body">
  <div class="app-root">
    <div class="sidebar-backdrop" id="sidebar-backdrop" hidden></div>
    <aside class="aside" id="app-aside">
      <div class="aside-brand">
        <div class="logo">AI</div>
        <div class="aside-brand-text">
          <div class="title">LPDP AI</div>
          <div class="subtitle">Neural Console</div>
        </div>
      </div>
      <div class="aside-status" title="System online">
        <span class="ai-pulse"></span>
        <span class="aside-status-text">SYSTEM ONLINE</span>
      </div>
      <ul class="aside-menu">
        <li class="menu-section">Main</li>
        <li>
          <a href="/admin" class="<%= activeMenu === 'dashboard' ? 'active' : '' %>" title="Dashboard">
            <i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span>
          </a>
        </li>
        <li>
          <a href="/admin/chat" class="<%= activeMenu === 'chat' ? 'active' : '' %>" title="AI Chat">
            <i class="bi bi-chat-dots-fill"></i><span>AI Chat</span>
          </a>
        </li>
        <li class="menu-section">Access</li>
        <li>
          <a href="/admin/users" class="<%= activeMenu === 'users' ? 'active' : '' %>" title="Users">
            <i class="bi bi-people-fill"></i><span>Users</span>
          </a>
        </li>
        <li>
          <a href="/admin/whitelist" class="<%= activeMenu === 'whitelist' ? 'active' : '' %>" title="IP Whitelist">
            <i class="bi bi-shield-lock-fill"></i><span>IP Whitelist</span>
          </a>
        </li>
        <li>
          <a href="/admin/tokens" class="<%= activeMenu === 'tokens' ? 'active' : '' %>" title="API Tokens">
            <i class="bi bi-key-fill"></i><span>API Tokens</span>
          </a>
        </li>
        <li class="menu-section">Monitoring</li>
        <li>
          <a href="/admin/logs" class="<%= activeMenu === 'logs' ? 'active' : '' %>" title="AI Logs">
            <i class="bi bi-journal-text"></i><span>AI Logs</span>
          </a>
        </li>
        <li class="menu-section">System</li>
        <li>
          <a href="/admin/settings" class="<%= activeMenu === 'settings' ? 'active' : '' %>" title="Settings">
            <i class="bi bi-gear-fill"></i><span>Settings</span>
          </a>
        </li>
      </ul>
      <div class="aside-foot">
        <span>lpdp-ai://console</span>
      </div>
    </aside>

    <div class="wrapper">
      <header class="header">
        <div class="header-left">
          <button type="button" class="sidebar-toggle" id="sidebar-toggle" title="Collapse / expand sidebar" aria-label="Toggle sidebar" aria-controls="app-aside" aria-expanded="true">
            <i class="bi bi-layout-sidebar-inset"></i>
          </button>
          <div>
            <p class="header-kicker">// admin module</p>
            <h1><%= pageTitle %></h1>
          </div>
        </div>
        <div class="user-chip">
          <div class="user-avatar"><i class="bi bi-cpu"></i></div>
          <div class="user-meta">
            <span class="user-label">Operator</span>
            <span class="user-name"><%= admin.sub %></span>
          </div>
          <a class="btn btn-sm btn-light-primary" href="/admin/account/password" title="Change password">
            <i class="bi bi-key"></i>
          </a>
          <form method="post" action="/admin/logout" class="d-inline">
            <button class="btn btn-sm btn-light-danger" type="submit">Logout</button>
          </form>
        </div>
      </header>
      <main class="content">
        <% if (typeof flash !== 'undefined' && flash) { %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <%= flash %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>
