<ul class="password-rules small mt-2 mb-0 ps-0 list-unstyled" id="<%= inputId %>_rules">
  <li data-rule="length"><i class="bi bi-x-circle"></i> Minimal 8 karakter</li>
  <li data-rule="lower"><i class="bi bi-x-circle"></i> Huruf kecil (a-z)</li>
  <li data-rule="upper"><i class="bi bi-x-circle"></i> Huruf besar (A-Z)</li>
  <li data-rule="digit"><i class="bi bi-x-circle"></i> Angka (0-9)</li>
  <li data-rule="symbol"><i class="bi bi-x-circle"></i> Simbol (mis. !@#$%)</li>
  <li data-rule="nouser"><i class="bi bi-x-circle"></i> Tidak mengandung username</li>
</ul>
<script>
  (function () {
    var input = document.getElementById('<%= inputId %>');
    var list = document.getElementById('<%= inputId %>_rules');
    if (!input || !list) return;
    var username = <%- JSON.stringify(String(username || '').toLowerCase()) %>;
    var checks = {
      length: function (v) { return v.length >= 8; },
      lower: function (v) { return /[a-z]/.test(v); },
      upper: function (v) { return /[A-Z]/.test(v); },
      digit: function (v) { return /[0-9]/.test(v); },
      symbol: function (v) { return /[^A-Za-z0-9]/.test(v); },
      nouser: function (v) {
        return v.length > 0 && (username.length < 3 || v.toLowerCase().indexOf(username) === -1);
      },
    };
    function update() {
      var v = input.value || '';
      var allOk = true;
      list.querySelectorAll('li').forEach(function (li) {
        var ok = checks[li.getAttribute('data-rule')](v);
        if (!ok) allOk = false;
        li.classList.toggle('text-success', ok);
        li.classList.toggle('text-muted', !ok);
        var icon = li.querySelector('i');
        icon.className = ok ? 'bi bi-check-circle-fill' : 'bi bi-x-circle';
      });
      input.setCustomValidity(v && !allOk ? 'Password belum memenuhi semua syarat' : '');
    }
    input.addEventListener('input', update);
    update();
  })();
</script>
