<%- include('partials/shell-start') %>

<div class="stat-grid">
  <div class="stat-card">
    <div class="icon bg-primary-soft"><i class="bi bi-people-fill"></i></div>
    <div class="label">Total Users</div>
    <div class="value"><%= counts.users_count %></div>
  </div>
  <div class="stat-card">
    <div class="icon bg-success-soft"><i class="bi bi-person-badge-fill"></i></div>
    <div class="label">Active API Users</div>
    <div class="value"><%= counts.api_users_count %></div>
  </div>
  <div class="stat-card">
    <div class="icon bg-warning-soft"><i class="bi bi-shield-lock-fill"></i></div>
    <div class="label">Whitelist IPs</div>
    <div class="value"><%= counts.whitelist_count %></div>
  </div>
  <div class="stat-card">
    <div class="icon bg-info-soft"><i class="bi bi-key-fill"></i></div>
    <div class="label">Active Tokens</div>
    <div class="value"><%= counts.tokens_count %></div>
  </div>
</div>

<div class="card-panel">
  <div class="card-header-bar">
    <h2>Quick info</h2>
  </div>
  <div class="card-body-pad">
    <div class="row g-3">
      <div class="col-md-4">
        <div class="text-muted small fw-semibold">AI Provider</div>
        <div class="fs-5 fw-bold text-uppercase"><%= settings.ai_provider || 'openai' %></div>
      </div>
      <div class="col-md-4">
        <div class="text-muted small fw-semibold">Model</div>
        <div class="fs-5 fw-bold">
          <%= (settings.ai_provider === 'ollama'
                ? (settings.ollama_model || '-')
                : (settings.openai_model || '-')) %>
        </div>
      </div>
      <div class="col-md-2">
        <div class="text-muted small fw-semibold">IP Whitelist</div>
        <div class="fs-5 fw-bold"><%= settings.ip_whitelist_enabled === 'true' ? 'Enabled' : 'Disabled' %></div>
      </div>
      <div class="col-md-2">
        <div class="text-muted small fw-semibold">Max Upload</div>
        <div class="fs-5 fw-bold"><%= settings.max_upload_mb || '-' %> MB</div>
      </div>
    </div>
    <hr />
    <p class="mb-0 text-muted">Use the sidebar to manage <strong>Users</strong>, <strong>IP Whitelist</strong>, <strong>API Tokens</strong>, and <strong>Settings</strong>.</p>
  </div>
</div>

<%- include('partials/shell-end') %>
