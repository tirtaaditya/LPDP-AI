<%- include('../partials/shell-start') %>

<div class="card-panel">
  <div class="card-header-bar">
    <h2>System Settings</h2>
  </div>
  <div class="card-body-pad">
    <form method="post" action="/admin/settings" class="row g-3" style="max-width:820px;">
      <%- include('../partials/csrf') %>
      <div class="col-12">
        <label class="form-label">AI Provider</label>
        <div class="d-flex gap-4">
          <div class="form-check">
            <input class="form-check-input" type="radio" name="ai_provider" id="provider_openai" value="openai"
              <%= (settings.ai_provider || 'openai') !== 'ollama' ? 'checked' : '' %> />
            <label class="form-check-label fw-semibold" for="provider_openai">OpenAI</label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="radio" name="ai_provider" id="provider_ollama" value="ollama"
              <%= settings.ai_provider === 'ollama' ? 'checked' : '' %> />
            <label class="form-check-label fw-semibold" for="provider_ollama">Ollama</label>
          </div>
        </div>
        <div class="form-text">Pilih provider aktif untuk endpoint extract. Disimpan di database.</div>
      </div>

      <div class="col-12"><hr class="my-1" /><div class="fw-bold">OpenAI</div></div>
      <div class="col-12">
        <label class="form-label">OpenAI API Key</label>
        <input
          class="form-control"
          type="password"
          name="openai_api_key"
          value=""
          autocomplete="new-password"
          placeholder="<%= hasOpenAiKey ? ('Key tersimpan: ' + openAiKeyHint + ' — kosongkan jika tidak diganti') : 'sk-proj-... paste key di sini' %>"
        />
        <div class="form-text">
          <% if (hasOpenAiKey) { %>Status: <span class="text-success fw-semibold">sudah di-set</span>.<% } else { %>Status: <span class="text-danger fw-semibold">belum di-set</span>.<% } %>
        </div>
      </div>
      <div class="col-md-6">
        <label class="form-label">OpenAI Model</label>
        <% const openAiModel = settings.openai_model || 'gpt-4o-mini'; %>
        <% const openAiModels = ['gpt-4o-mini', 'gpt-4o', 'gpt-4.1-mini', 'gpt-4.1', 'gpt-5-mini', 'gpt-5']; %>
        <div class="input-group">
          <select class="form-select" name="openai_model" id="openai_model">
            <% if (!openAiModels.includes(openAiModel)) { %>
              <option value="<%= openAiModel %>" selected>Custom: <%= openAiModel %></option>
            <% } %>
            <% openAiModels.forEach((model) => { %>
              <option value="<%= model %>" <%= openAiModel === model ? 'selected' : '' %>><%= model %></option>
            <% }); %>
          </select>
          <button class="btn btn-outline-secondary" type="button" id="refresh-openai-models" title="Tarik ulang daftar model OpenAI" aria-label="Tarik ulang daftar model OpenAI">
            <i class="bi bi-arrow-clockwise"></i>
          </button>
        </div>
        <div class="form-text" id="openai-model-status">Daftar model akan ditarik otomatis dari API key OpenAI saat halaman dibuka. Default: <code>gpt-4o-mini</code>. PDF/gambar yang memakai Vision otomatis menggunakan <code>gpt-4o</code> bila model utama berakhiran <code>mini</code> atau <code>nano</code>.</div>
      </div>
      <div class="col-md-4">
        <label class="form-label">Image model</label>
        <input class="form-control" name="openai_image_model" value="<%= settings.openai_image_model || 'gpt-image-1' %>" placeholder="gpt-image-1" />
      </div>
      <div class="col-md-2">
        <label class="form-label">Image size</label>
        <select class="form-select" name="openai_image_size">
          <% const imgSize = settings.openai_image_size || '1024x1024'; %>
          <option value="1024x1024" <%= imgSize === '1024x1024' ? 'selected' : '' %>>1024×1024</option>
          <option value="1536x1024" <%= imgSize === '1536x1024' ? 'selected' : '' %>>1536×1024</option>
          <option value="1024x1536" <%= imgSize === '1024x1536' ? 'selected' : '' %>>1024×1536</option>
          <option value="1024x1792" <%= imgSize === '1024x1792' ? 'selected' : '' %>>1024×1792 (DALL·E 3)</option>
          <option value="1792x1024" <%= imgSize === '1792x1024' ? 'selected' : '' %>>1792×1024 (DALL·E 3)</option>
        </select>
      </div>
      <div class="col-12">
        <div class="form-text">
          Rekomendasi model: <code>gpt-image-1</code> / <code>gpt-image-2</code>.
          Kalau error “model does not exist”, ganti Image model di sini sesuai akses API key kamu.
          Chat Image mode / perintah <code>/image ...</code> butuh provider OpenAI.
        </div>
      </div>

      <div class="col-12"><hr class="my-1" /><div class="fw-bold">Ollama</div></div>
      <div class="col-md-8">
        <label class="form-label">Ollama Base URL</label>
        <input class="form-control" name="ollama_base_url" value="<%= settings.ollama_base_url || '' %>" placeholder="http://10.44.200.73:11434" />
        <div class="form-text">Tanpa trailing slash. App otomatis pakai <code>/v1</code> (OpenAI-compatible).</div>
      </div>
      <div class="col-md-4">
        <label class="form-label">Ollama Model</label>
        <input class="form-control" name="ollama_model" value="<%= settings.ollama_model || '' %>" placeholder="gpt-oss:latest" />
      </div>
      <div class="col-12">
        <label class="form-label">Ollama API Key</label>
        <input
          class="form-control"
          type="password"
          name="ollama_api_key"
          value=""
          autocomplete="new-password"
          placeholder="<%= hasOllamaKey ? ('Key tersimpan: ' + ollamaKeyHint + ' — kosongkan jika tidak diganti') : 'lpdp_...' %>"
        />
        <div class="form-text">
          <% if (hasOllamaKey) { %>Status: <span class="text-success fw-semibold">sudah di-set</span>.<% } else { %>Status: <span class="text-danger fw-semibold">belum di-set</span>.<% } %>
          Catatan: PDF scan (tanpa teks) sebaiknya pakai OpenAI.
        </div>
      </div>

      <div class="col-12"><hr class="my-1" /><div class="fw-bold">Token pricing (estimasi biaya)</div>
        <div class="form-text mb-2">
          Estimasi dihitung di app (bukan pull live dari OpenAI). Harga <strong>per model</strong> pakai katalog bawaan
          (contoh: gpt-4o-mini $0.15/$0.60 · gpt-4o $2.50/$10.00 per 1M). Field di bawah = fallback untuk model yang belum ada di katalog (mis. Ollama).
          Hasil disimpan ke log sebagai <code>cost_usd</code>/<code>cost_idr</code>.
        </div>
      </div>
      <div class="col-md-3">
        <label class="form-label">Fallback prompt / 1M USD</label>
        <input class="form-control" name="openai_price_prompt_per_1m_usd" type="number" step="0.0001" min="0"
          value="<%= settings.openai_price_prompt_per_1m_usd || '0.15' %>" />
      </div>
      <div class="col-md-3">
        <label class="form-label">Fallback completion / 1M USD</label>
        <input class="form-control" name="openai_price_completion_per_1m_usd" type="number" step="0.0001" min="0"
          value="<%= settings.openai_price_completion_per_1m_usd || '0.60' %>" />
      </div>
      <div class="col-md-3">
        <label class="form-label">USD → IDR</label>
        <input class="form-control" name="usd_to_idr" type="number" step="1" min="0"
          value="<%= settings.usd_to_idr || '16000' %>" />
        <div class="form-text">Bisa diisi manual atau auto dari Kurs BI LPDP.</div>
      </div>
      <div class="col-md-3">
        <label class="form-label">Image price USD</label>
        <input class="form-control" name="openai_image_price_usd" type="number" step="0.0001" min="0"
          value="<%= settings.openai_image_price_usd || '0.04' %>" />
      </div>

      <div class="col-12"><hr class="my-1" /><div class="fw-bold">Kurs BI otomatis (API Gateway LPDP)</div>
        <div class="form-text mb-2">
          Sumber: <a href="https://api-channellpdp.kemenkeu.go.id" target="_blank" rel="noopener">api-channellpdp.kemenkeu.go.id</a>
          → <code>/Users/authenticate</code> lalu <code>/Kurs/bi?Currency=USD</code>.
          Jadwal default: setiap hari jam <strong>10:00 WIB</strong>.
        </div>
      </div>
      <div class="col-md-6 d-flex align-items-center">
        <div class="form-check form-switch">
          <input class="form-check-input" type="checkbox" role="switch" id="kurs_auto_enabled"
                 name="kurs_auto_enabled" value="true"
                 <%= settings.kurs_auto_enabled === 'true' ? 'checked' : '' %> />
          <label class="form-check-label fw-semibold" for="kurs_auto_enabled">
            Aktifkan update kurs otomatis
          </label>
        </div>
      </div>
      <div class="col-md-3">
        <label class="form-label">Jam sync (WIB)</label>
        <input class="form-control" name="kurs_schedule_hour" type="number" min="0" max="23" step="1"
          value="<%= settings.kurs_schedule_hour || '10' %>" />
      </div>
      <div class="col-md-3">
        <label class="form-label">Ambil kurs</label>
        <select class="form-select" name="kurs_rate_mode">
          <option value="mid" <%= (settings.kurs_rate_mode || 'mid') === 'mid' ? 'selected' : '' %>>Mid (beli+jual)/2</option>
          <option value="beli" <%= settings.kurs_rate_mode === 'beli' ? 'selected' : '' %>>Kurs beli</option>
          <option value="jual" <%= settings.kurs_rate_mode === 'jual' ? 'selected' : '' %>>Kurs jual</option>
        </select>
      </div>
      <div class="col-md-6">
        <label class="form-label">API base URL</label>
        <input class="form-control" name="kurs_api_base_url"
          value="<%= settings.kurs_api_base_url || 'https://api-channellpdp.kemenkeu.go.id' %>" />
      </div>
      <div class="col-md-3">
        <label class="form-label">Email / username</label>
        <input class="form-control" name="kurs_api_email" autocomplete="username"
          value="<%= settings.kurs_api_email || '' %>" placeholder="akun API Gateway" />
      </div>
      <div class="col-md-3">
        <label class="form-label">Password API</label>
        <input class="form-control" name="kurs_api_password" type="password" autocomplete="new-password"
          placeholder="<%= hasKursPassword ? '•••• (isi untuk ganti)' : 'password API Gateway' %>" />
      </div>
      <div class="col-12">
        <div class="small text-muted mb-2">
          Last sync: <strong><%= settings.kurs_last_sync_at || '-' %></strong>
          · value: <strong><%= settings.kurs_last_value || settings.usd_to_idr || '-' %></strong>
          <% if (settings.kurs_last_error) { %>
            <br /><span class="text-danger">Last error: <%= settings.kurs_last_error %></span>
          <% } %>
        </div>
        <button formaction="/admin/settings/kurs-sync" formmethod="post" class="btn btn-outline-primary btn-sm" type="submit">
          Sync kurs sekarang
        </button>
      </div>
      <div class="col-12">
        <div class="form-text">
          Dipakai untuk estimasi biaya di AI Logs &amp; Dashboard.
          Default mengikuti kisaran <code>gpt-4o-mini</code>. Sesuaikan dengan harga model di OpenAI Pricing.
          Image price dipakai saat generate gambar (tanpa token usage).
        </div>
      </div>

      <div class="col-12"><hr class="my-1" /><div class="fw-bold">Common</div></div>
      <div class="col-md-3">
        <label class="form-label">Temperature</label>
        <input class="form-control" name="temperature" value="<%= settings.temperature || '' %>" />
      </div>
      <div class="col-md-3">
        <label class="form-label">Max tokens</label>
        <input class="form-control" name="max_tokens" value="<%= settings.max_tokens || '' %>" />
      </div>
      <div class="col-md-3">
        <label class="form-label">Max upload (MB)</label>
        <input class="form-control" name="max_upload_mb" value="<%= settings.max_upload_mb || '' %>" />
      </div>
      <div class="col-12">
        <label class="form-label">Allowed file types</label>
        <input
          class="form-control"
          name="allowed_file_types"
          value="<%= settings.allowed_file_types || 'pdf,docx,txt' %>"
          placeholder="pdf,docx,txt,jpg,jpeg,png"
        />
        <div class="form-text">
          Pisahkan dengan koma. Contoh: <code>pdf,docx,txt,jpg,jpeg,png,webp</code>.
          Berlaku untuk API extract (<code>file_urls</code>) dan Admin Chat upload.
          Image/scan PDF butuh provider <strong>OpenAI</strong> (vision).
        </div>
      </div>
      <div class="col-12">
        <label class="form-label">System prompt</label>
        <textarea class="form-control" name="system_prompt" rows="6"><%= settings.system_prompt || '' %></textarea>
      </div>
      <div class="col-12">
        <div class="form-check form-switch">
          <input class="form-check-input" type="checkbox" role="switch" id="ip_whitelist_enabled"
                 name="ip_whitelist_enabled" value="true"
                 <%= settings.ip_whitelist_enabled === 'true' ? 'checked' : '' %> />
          <label class="form-check-label fw-semibold" for="ip_whitelist_enabled">
            Enable IP whitelist (per API user)
          </label>
        </div>
      </div>
      <div class="col-12 pt-2">
        <button type="submit" class="btn btn-primary px-4">Save Settings</button>
      </div>
    </form>
  </div>
</div>

<script>
  (function () {
    var select = document.getElementById('openai_model');
    var refreshButton = document.getElementById('refresh-openai-models');
    var status = document.getElementById('openai-model-status');
    if (!select || !refreshButton || !status) return;

    function loadModels() {
      var selectedModel = select.value;
      refreshButton.disabled = true;
      status.textContent = 'Mengambil daftar model dari OpenAI...';

      fetch('/admin/settings/openai-models', { credentials: 'same-origin' })
        .then(function (response) { return response.json(); })
        .then(function (payload) {
          if (!payload || payload.status !== 'success' || !Array.isArray(payload.data?.models)) {
            throw new Error(payload?.message || 'Daftar model tidak tersedia.');
          }

          var models = payload.data.models;
          select.replaceChildren();
          models.forEach(function (model) {
            var option = document.createElement('option');
            option.value = model;
            option.textContent = model;
            select.appendChild(option);
          });

          if (!models.includes(selectedModel)) {
            var customOption = document.createElement('option');
            customOption.value = selectedModel;
            customOption.textContent = 'Custom: ' + selectedModel;
            select.prepend(customOption);
          }
          select.value = selectedModel;
          status.textContent = models.length + ' model tersedia dari API key OpenAI ini.';
        })
        .catch(function (error) {
          status.textContent = error.message || 'Gagal mengambil daftar model. Pilihan fallback tetap tersedia.';
        })
        .finally(function () {
          refreshButton.disabled = false;
        });
    }

    refreshButton.addEventListener('click', loadModels);
    loadModels();
  })();
</script>

<%- include('../partials/shell-end') %>
