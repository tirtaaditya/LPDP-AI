<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Login | AI LPDP Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link href="/public/css/admin.css" rel="stylesheet" />
</head>
<body class="login-body">
  <div class="login-page ai-login">
    <canvas id="ai-net" class="ai-net" aria-hidden="true"></canvas>
    <div class="ai-scanline" aria-hidden="true"></div>
    <div class="ai-glow ai-glow-1" aria-hidden="true"></div>
    <div class="ai-glow ai-glow-2" aria-hidden="true"></div>

    <main class="ai-login-frame">
      <header class="ai-login-top">
        <div class="ai-badge">
          <span class="ai-pulse"></span>
          SYSTEM ONLINE
        </div>
        <div class="ai-model-chip">LPDP · Neural Access</div>
      </header>

      <div class="ai-login-grid">
        <section class="ai-hero">
          <p class="ai-kicker">// intelligence layer</p>
          <h1 class="ai-brand">
            <span class="ai-brand-ai">AI</span>
            <span class="ai-brand-name">LPDP</span>
          </h1>
          <p class="ai-tagline">Extraction · Reasoning · Control</p>
          <p class="ai-copy">
            Masuk ke pusat kendali model AI. Kelola token, whitelist, provider, dan jejak inferensi dalam satu console.
          </p>

          <div class="ai-terminal" aria-hidden="true">
            <div class="ai-terminal-bar">
              <span></span><span></span><span></span>
              <em>lpdp-ai://admin</em>
            </div>
            <pre class="ai-terminal-body"><code><span class="t-muted">$</span> auth.init<span class="t-cyan">()</span>
<span class="t-green">✓</span> provider<span class="t-muted">:</span> ready
<span class="t-green">✓</span> session<span class="t-muted">:</span> awaiting credentials
<span class="t-cursor">▌</span></code></pre>
          </div>
        </section>

        <section class="ai-panel">
          <form class="ai-form" method="post" action="/admin/login" autocomplete="on">
            <%- include('partials/csrf') %>
            <div class="ai-form-title">
              <h2>Authenticate</h2>
              <p>Admin identity required</p>
            </div>

            <% if (error) { %>
              <div class="ai-alert" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span><%= error %></span>
              </div>
            <% } %>

            <label class="ai-field">
              <span>Username</span>
              <div class="ai-input">
                <i class="bi bi-cpu"></i>
                <input id="username" name="username" type="text" required autocomplete="username" placeholder="admin" />
              </div>
            </label>

            <label class="ai-field">
              <span>Access Key</span>
              <div class="ai-input">
                <i class="bi bi-fingerprint"></i>
                <input id="password" name="password" type="password" required autocomplete="current-password" placeholder="••••••••••••" />
              </div>
            </label>

            <div class="ai-field ai-captcha-field">
              <span>Captcha (angka)</span>
              <div class="ai-captcha">
                <div class="ai-captcha-visual" id="captcha-visual">
                  <%- captchaSvg %>
                </div>
                <div class="ai-captcha-actions">
                  <button type="button" class="ai-captcha-btn" id="captcha-audio" title="Putar suara">
                    <i class="bi bi-volume-up-fill"></i>
                    <span>Suara</span>
                  </button>
                  <button type="button" class="ai-captcha-btn" id="captcha-refresh" title="Ganti captcha">
                    <i class="bi bi-arrow-clockwise"></i>
                    <span>Ganti</span>
                  </button>
                </div>
              </div>
              <div class="ai-input">
                <i class="bi bi-shield-check"></i>
                <input
                  id="captcha"
                  name="captcha"
                  type="text"
                  inputmode="numeric"
                  pattern="[0-9]{5}"
                  maxlength="5"
                  minlength="5"
                  required
                  autocomplete="off"
                  placeholder="Ketik 5 digit angka"
                />
              </div>
              <div class="ai-captcha-hint">Masukkan angka yang ditampilkan, atau dengarkan via tombol Suara.</div>
            </div>

            <button class="ai-submit" type="submit">
              <span>Initialize Session</span>
              <i class="bi bi-lightning-charge-fill"></i>
            </button>

            <p class="ai-footnote">Encrypted admin channel · LPDP AI Console</p>
          </form>
        </section>
      </div>
    </main>
  </div>

  <script>
    (function () {
      const visual = document.getElementById('captcha-visual');
      const refreshBtn = document.getElementById('captcha-refresh');
      const audioBtn = document.getElementById('captcha-audio');
      const input = document.getElementById('captcha');
      let audioEl = null;

      if (refreshBtn && visual) {
        refreshBtn.addEventListener('click', async function () {
          try {
            refreshBtn.disabled = true;
            const res = await fetch('/admin/captcha/refresh', {
              credentials: 'same-origin',
              headers: { Accept: 'application/json' },
            });
            const json = await res.json();
            if (json && json.data && json.data.svg) {
              visual.innerHTML = json.data.svg;
              if (input) {
                input.value = '';
                input.focus();
              }
            }
          } catch (err) {
            console.error(err);
          } finally {
            refreshBtn.disabled = false;
          }
        });
      }

      if (audioBtn) {
        audioBtn.addEventListener('click', function () {
          const digitNames = {
            0: 'nol', 1: 'satu', 2: 'dua', 3: 'tiga', 4: 'empat',
            5: 'lima', 6: 'enam', 7: 'tujuh', 8: 'delapan', 9: 'sembilan'
          };
          const digits = visual
            ? Array.from(visual.querySelectorAll('text'))
                .map(function (el) { return String(el.textContent || '').trim(); })
                .join('')
            : '';

          if (digits && window.speechSynthesis) {
            window.speechSynthesis.cancel();
            const spoken = digits
              .split('')
              .map(function (d) { return digitNames[d] || d; })
              .join(', ');
            const utter = new SpeechSynthesisUtterance(spoken);
            utter.lang = 'id-ID';
            utter.rate = 0.9;
            window.speechSynthesis.speak(utter);
            return;
          }

          if (audioEl) {
            audioEl.pause();
            audioEl = null;
          }
          audioEl = new Audio('/admin/captcha/audio?ts=' + Date.now());
          audioEl.play().catch(function (err) {
            console.error(err);
          });
        });
      }
    })();
  </script>
  <script>
    (function () {
      const canvas = document.getElementById('ai-net');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      let w, h, nodes, raf;

      function resize() {
        w = canvas.width = window.innerWidth;
        h = canvas.height = window.innerHeight;
        const count = Math.min(70, Math.floor((w * h) / 18000));
        nodes = Array.from({ length: count }, () => ({
          x: Math.random() * w,
          y: Math.random() * h,
          vx: (Math.random() - 0.5) * 0.35,
          vy: (Math.random() - 0.5) * 0.35,
        }));
      }

      function draw() {
        ctx.clearRect(0, 0, w, h);
        for (const n of nodes) {
          n.x += n.vx;
          n.y += n.vy;
          if (n.x < 0 || n.x > w) n.vx *= -1;
          if (n.y < 0 || n.y > h) n.vy *= -1;
        }
        for (let i = 0; i < nodes.length; i++) {
          for (let j = i + 1; j < nodes.length; j++) {
            const a = nodes[i], b = nodes[j];
            const dx = a.x - b.x, dy = a.y - b.y;
            const dist = Math.hypot(dx, dy);
            if (dist < 140) {
              const alpha = (1 - dist / 140) * 0.28;
              ctx.strokeStyle = `rgba(0, 210, 255, ${alpha})`;
              ctx.lineWidth = 1;
              ctx.beginPath();
              ctx.moveTo(a.x, a.y);
              ctx.lineTo(b.x, b.y);
              ctx.stroke();
            }
          }
        }
        for (const n of nodes) {
          ctx.fillStyle = 'rgba(80, 230, 180, 0.85)';
          ctx.beginPath();
          ctx.arc(n.x, n.y, 1.6, 0, Math.PI * 2);
          ctx.fill();
        }
        raf = requestAnimationFrame(draw);
      }

      resize();
      draw();
      window.addEventListener('resize', () => {
        cancelAnimationFrame(raf);
        resize();
        draw();
      });
    })();
  </script>
</body>
</html>
