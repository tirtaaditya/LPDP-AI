<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Login | AI LPDP Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet" />
  <link href="/public/css/admin.css" rel="stylesheet" />
</head>
<body>
  <div class="login-page">
    <form class="login-card" method="post" action="/admin/login">
      <h1>AI LPDP Admin</h1>
      <p>Sign in with your admin account from the database.</p>
      <% if (error) { %>
        <div class="alert alert-danger py-2"><%= error %></div>
      <% } %>
      <div class="mb-3">
        <label class="form-label" for="username">Username</label>
        <input class="form-control" id="username" name="username" required autocomplete="username" />
      </div>
      <div class="mb-3">
        <label class="form-label" for="password">Password</label>
        <input class="form-control" id="password" name="password" type="password" required autocomplete="current-password" />
      </div>
      <button class="btn btn-primary w-100 py-2 fw-bold" type="submit">Sign In</button>
    </form>
  </div>
</body>
</html>
