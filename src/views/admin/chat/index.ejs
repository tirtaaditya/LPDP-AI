<%- include('../partials/shell-start') %>

<div class="chat-shell card-panel">
  <div class="chat-toolbar">
    <div>
      <div class="fw-bold">AI Chat</div>
      <div class="small text-muted">
        Provider: <strong class="text-uppercase"><%= provider %></strong>
        · Model: <strong><%= model %></strong>
      </div>
    </div>
    <button type="button" id="btn-clear-chat" class="btn btn-sm btn-light-danger">Clear chat</button>
  </div>

  <div id="chat-messages" class="chat-messages">
    <div class="chat-bubble assistant">
      Halo! Saya asisten AI LPDP. Ada yang ingin kamu tanyakan?
    </div>
  </div>

  <div id="chat-file-preview" class="chat-file-preview d-none"></div>

  <form id="chat-form" class="chat-composer">
    <label class="chat-attach btn btn-light-primary mb-0" title="Attach files">
      <i class="bi bi-paperclip"></i>
      <input type="file" id="chat-files" name="files" multiple accept=".pdf,.docx,.txt,application/pdf" hidden />
    </label>
    <textarea id="chat-input" rows="1" placeholder="Tulis pesan... (Enter kirim, Shift+Enter baris baru)" required></textarea>
    <button type="submit" id="chat-send" class="btn btn-primary">
      <i class="bi bi-send-fill"></i>
    </button>
  </form>
  <button type="button" id="chat-jump" class="chat-jump" title="Scroll to latest">
    <i class="bi bi-arrow-down"></i> Latest
  </button>
</div>

<style>
  .content:has(.chat-shell) {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 74px);
    min-height: 0;
    overflow: hidden;
    padding-bottom: 16px;
  }
  .chat-shell {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    height: 100%;
    overflow: hidden;
  }
  .chat-toolbar {
    flex: 0 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--card-border);
    background: #fff;
  }
  .chat-messages {
    flex: 1 1 auto;
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
    padding: 18px;
    scroll-behavior: smooth;
    background:
      radial-gradient(circle at 12% 0%, rgba(34, 211, 238, 0.08), transparent 42%),
      #f8fafc;
  }
  .chat-messages::-webkit-scrollbar {
    width: 8px;
  }
  .chat-messages::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 999px;
  }
  .chat-messages::-webkit-scrollbar-track {
    background: transparent;
  }
  .chat-bubble {
    position: relative;
    max-width: min(720px, 92%);
    padding: 12px 14px;
    border-radius: 14px;
    margin-bottom: 12px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    word-break: break-word;
    line-height: 1.5;
    font-size: 0.95rem;
  }
  .chat-bubble.is-collapsed {
    max-height: 240px;
    overflow: hidden;
  }
  .chat-bubble.is-collapsed::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 64px;
    pointer-events: none;
    border-radius: 0 0 14px 14px;
  }
  .chat-bubble.user {
    margin-left: auto;
    background: linear-gradient(135deg, #0891b2, #22d3ee);
    color: #021018;
    font-weight: 550;
    border-bottom-right-radius: 4px;
  }
  .chat-bubble.user.is-collapsed::after {
    background: linear-gradient(transparent, #14b8c8);
  }
  .chat-bubble.assistant {
    margin-right: auto;
    background: #fff;
    border: 1px solid var(--card-border);
    border-bottom-left-radius: 4px;
    color: #334155;
  }
  .chat-bubble.assistant.is-collapsed::after {
    background: linear-gradient(transparent, #fff);
  }
  .chat-bubble.system-error {
    margin-right: auto;
    background: #fff1f2;
    border: 1px solid #fecdd3;
    color: #be123c;
  }
  .chat-bubble.system-error.is-collapsed::after {
    background: linear-gradient(transparent, #fff1f2);
  }
  .chat-expand {
    position: relative;
    z-index: 1;
    display: inline-flex;
    margin-top: 10px;
    border: 0;
    border-radius: 999px;
    padding: 4px 10px;
    font: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    background: rgba(15, 23, 42, 0.06);
    color: #0f172a;
  }
  .chat-bubble.user .chat-expand {
    background: rgba(2, 16, 24, 0.12);
    color: #021018;
  }
  .chat-meta {
    display: block;
    margin-top: 6px;
    font-size: 0.75rem;
    opacity: 0.75;
    font-family: "JetBrains Mono", ui-monospace, monospace;
  }
  .chat-file-preview {
    flex: 0 0 auto;
    padding: 8px 18px 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    max-height: 72px;
    overflow-y: auto;
  }
  .chat-file-chip {
    background: #ecfeff;
    color: #0e7490;
    border: 1px solid #cffafe;
    border-radius: 999px;
    padding: 4px 10px;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .chat-composer {
    flex: 0 0 auto;
    display: flex;
    align-items: flex-end;
    gap: 10px;
    padding: 14px 18px 16px;
    border-top: 1px solid var(--card-border);
    background: #fff;
  }
  .chat-composer textarea {
    flex: 1;
    resize: none;
    min-height: 44px;
    max-height: 120px;
    border: 1px solid #dbe3ee;
    border-radius: 12px;
    padding: 10px 12px;
    font: inherit;
    background: #fff;
    color: #0f172a;
  }
  .chat-composer textarea:focus {
    outline: none;
    border-color: #22d3ee;
    box-shadow: 0 0 0 0.15rem rgba(34, 211, 238, 0.15);
  }
  .chat-attach {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    cursor: pointer;
    flex: 0 0 auto;
  }
  #chat-send {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
  }
  .chat-typing {
    font-size: 0.85rem;
    color: #64748b;
    margin-bottom: 8px;
    font-family: "JetBrains Mono", ui-monospace, monospace;
  }
  .chat-jump {
    position: absolute;
    right: 28px;
    bottom: 92px;
    z-index: 5;
    display: none;
    border: 1px solid #a5f3fc;
    border-radius: 999px;
    padding: 8px 12px;
    background: #fff;
    color: #0e7490;
    font-size: 0.78rem;
    font-weight: 700;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.12);
    cursor: pointer;
  }
  .chat-jump.is-visible {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
</style>

<script>
(function () {
  const messagesEl = document.getElementById('chat-messages');
  const form = document.getElementById('chat-form');
  const input = document.getElementById('chat-input');
  const filesInput = document.getElementById('chat-files');
  const preview = document.getElementById('chat-file-preview');
  const sendBtn = document.getElementById('chat-send');
  const clearBtn = document.getElementById('btn-clear-chat');
  const jumpBtn = document.getElementById('chat-jump');

  let history = [];
  let pendingFiles = [];

  function nearBottom() {
    return messagesEl.scrollHeight - messagesEl.scrollTop - messagesEl.clientHeight < 80;
  }

  function scrollToBottom(force) {
    if (force || nearBottom()) {
      messagesEl.scrollTop = messagesEl.scrollHeight;
    }
    updateJump();
  }

  function updateJump() {
    if (!jumpBtn) return;
    jumpBtn.classList.toggle('is-visible', !nearBottom());
  }

  messagesEl.addEventListener('scroll', updateJump);
  if (jumpBtn) {
    jumpBtn.addEventListener('click', function () {
      messagesEl.scrollTop = messagesEl.scrollHeight;
      updateJump();
    });
  }

  function autoGrow() {
    input.style.height = 'auto';
    input.style.height = Math.min(input.scrollHeight, 120) + 'px';
  }
  input.addEventListener('input', autoGrow);

  filesInput.addEventListener('change', function () {
    pendingFiles = Array.from(filesInput.files || []);
    renderPreview();
  });

  function renderPreview() {
    if (!pendingFiles.length) {
      preview.classList.add('d-none');
      preview.innerHTML = '';
      return;
    }
    preview.classList.remove('d-none');
    preview.innerHTML = pendingFiles.map(function (f) {
      return '<span class="chat-file-chip"><i class="bi bi-file-earmark"></i> ' +
        escapeHtml(f.name) + '</span>';
    }).join('');
  }

  function escapeHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function isLongText(text) {
    const t = String(text || '');
    return t.length > 900 || t.split('\n').length > 16;
  }

  function appendBubble(role, text, meta) {
    const div = document.createElement('div');
    div.className = 'chat-bubble ' + role;
    const body = document.createElement('div');
    body.className = 'chat-bubble-body';
    body.textContent = text;
    div.appendChild(body);

    if (meta) {
      const m = document.createElement('span');
      m.className = 'chat-meta';
      m.textContent = meta;
      div.appendChild(m);
    }

    if (isLongText(text)) {
      div.classList.add('is-collapsed');
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'chat-expand';
      btn.textContent = 'Show more';
      btn.addEventListener('click', function () {
        const collapsed = div.classList.toggle('is-collapsed');
        btn.textContent = collapsed ? 'Show more' : 'Show less';
      });
      div.appendChild(btn);
    }

    messagesEl.appendChild(div);
    scrollToBottom(true);
  }

  clearBtn.addEventListener('click', function () {
    history = [];
    pendingFiles = [];
    filesInput.value = '';
    renderPreview();
    messagesEl.innerHTML = '';
    appendBubble('assistant', 'Chat dikosongkan. Silakan mulai percakapan baru.');
  });

  input.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      form.requestSubmit();
    }
  });

  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    const text = input.value.trim();
    if (!text && !pendingFiles.length) return;

    const fileNames = pendingFiles.map(function (f) { return f.name; });
    const userLabel = text || '(file only)';
    appendBubble(
      'user',
      userLabel + (fileNames.length ? '\n📎 ' + fileNames.join(', ') : '')
    );

    const fd = new FormData();
    fd.append('message', text);
    fd.append('history', JSON.stringify(history));
    pendingFiles.forEach(function (f) { fd.append('files', f); });

    input.value = '';
    autoGrow();
    pendingFiles = [];
    filesInput.value = '';
    renderPreview();
    sendBtn.disabled = true;

    const typing = document.createElement('div');
    typing.className = 'chat-typing ai-think';
    typing.id = 'chat-typing';
    typing.innerHTML = '<span>Model inferencing</span><span class="dots"><span></span><span></span><span></span></span>';
    messagesEl.appendChild(typing);
    scrollToBottom(true);

    try {
      const res = await fetch('/admin/chat/message', {
        method: 'POST',
        body: fd,
        credentials: 'same-origin'
      });
      const json = await res.json();
      const typingEl = document.getElementById('chat-typing');
      if (typingEl) typingEl.remove();

      if (!res.ok || json.status !== 'success') {
        appendBubble('system-error', json.message || 'Chat failed');
        return;
      }

      const reply = json.data.reply || '';
      const meta = json.data.meta || {};
      appendBubble(
        'assistant',
        reply,
        (meta.provider || '') + (meta.model ? ' · ' + meta.model : '')
      );

      history.push({ role: 'user', content: userLabel });
      history.push({ role: 'assistant', content: reply });
      if (history.length > 40) history = history.slice(-40);
    } catch (err) {
      const typingEl = document.getElementById('chat-typing');
      if (typingEl) typingEl.remove();
      appendBubble('system-error', err.message || 'Network error');
    } finally {
      sendBtn.disabled = false;
      input.focus();
    }
  });
})();
</script>

<%- include('../partials/shell-end') %>
