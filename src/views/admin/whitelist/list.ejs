<%- include('../partials/shell-start') %>

<div class="alert <%= whitelistEnabled ? 'alert-success' : 'alert-warning' %>">
  IP Whitelist global status:
  <strong><%= whitelistEnabled ? 'ENABLED' : 'DISABLED' %></strong>
  — ubah di menu Settings.
</div>

<div class="card-panel">
  <div class="card-header-bar">
    <h2>IP Whitelist (per API user)</h2>
    <a href="/admin/whitelist/create" class="btn btn-primary btn-sm">
      <i class="bi bi-plus-lg"></i> Add IP
    </a>
  </div>
  <div class="table-responsive">
    <table class="table table-modern table-hover align-middle mb-0 datatable w-100">
      <thead>
        <tr>
          <th>ID</th>
          <th>API User</th>
          <th>IP</th>
          <th>Label</th>
          <th>Created</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% ips.forEach(function(row) { %>
          <tr>
            <td><%= row.id %></td>
            <td class="fw-semibold"><%= row.username %></td>
            <td><code><%= row.ip %></code></td>
            <td><%= row.label || '-' %></td>
            <td><%= row.created_at %></td>
            <td class="text-end text-nowrap">
              <a href="/admin/whitelist/<%= row.id %>/edit" class="btn btn-sm btn-light-primary">Edit</a>
              <form method="post" action="/admin/whitelist/<%= row.id %>/delete" class="d-inline js-confirm-submit"
                    data-confirm="Delete this IP?"
                    data-label="<%= row.ip %>">
                <%- include('../partials/csrf') %>
                <button type="submit" class="btn btn-sm btn-light-danger">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/shell-end') %>
