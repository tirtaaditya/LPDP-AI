<%- include('../partials/shell-start') %>

<div class="password-page">
  <div class="card-panel password-card">
    <div class="card-header-bar">
      <h2>Change Password</h2>
      <span class="ai-chip"><%= admin.sub %></span>
    </div>
    <div class="card-body-pad">
      <% if (typeof flash !== 'undefined' && flash) { %>
        <div class="alert alert-success py-2" role="alert"><%= flash %></div>
      <% } %>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger py-2" role="alert"><%= error %></div>
      <% } %>
      <p class="text-muted mb-3">
        Ganti password akun admin yang sedang login. Password baru minimal 8 karakter.
      </p>
      <form method="post" action="/admin/account/password" class="row g-3" autocomplete="off"
        data-ai-loader-title="Updating credentials…"
        data-ai-loader-sub="Securing admin identity hash">
        <div class="col-12">
          <label class="form-label" for="current_password">Password saat ini</label>
          <input
            class="form-control"
            type="password"
            id="current_password"
            name="current_password"
            required
            autocomplete="current-password"
          />
        </div>
        <div class="col-12">
          <label class="form-label" for="new_password">Password baru</label>
          <input
            class="form-control"
            type="password"
            id="new_password"
            name="new_password"
            required
            minlength="8"
            autocomplete="new-password"
          />
        </div>
        <div class="col-12">
          <label class="form-label" for="confirm_password">Konfirmasi password baru</label>
          <input
            class="form-control"
            type="password"
            id="confirm_password"
            name="confirm_password"
            required
            minlength="8"
            autocomplete="new-password"
          />
        </div>
        <div class="col-12 d-flex gap-2 justify-content-center">
          <button class="btn btn-primary" type="submit">Update Password</button>
          <a class="btn btn-light-primary" href="/admin">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>

<style>
  .content:has(.password-page) {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 86px);
  }
  /* hide shell-level flash; shown inside the card instead */
  .content:has(.password-page) > .alert {
    display: none !important;
  }
  .password-page {
    width: min(520px, 100%);
  }
  .password-card {
    width: 100%;
  }
</style>

<%- include('../partials/shell-end') %>
