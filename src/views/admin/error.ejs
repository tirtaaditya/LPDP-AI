<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= pageTitle || 'Error' %> | AI LPDP Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="/public/css/admin.css" rel="stylesheet" />
</head>
<body class="app-body">
  <div class="container py-5" style="max-width:560px;">
    <div class="card-panel">
      <div class="card-header-bar"><h2><%= status || 500 %> — <%= pageTitle || 'Error' %></h2></div>
      <div class="card-body-pad">
        <p class="mb-3"><%= message || 'Something went wrong.' %></p>
        <a class="btn btn-primary" href="/admin">Back to Dashboard</a>
        <a class="btn btn-light ms-2" href="/admin/login">Login</a>
      </div>
    </div>
  </div>
</body>
</html>
