PORT=3000
NODE_ENV=development

# Users + OpenAI API key live in SQL Server (Admin UI / dbo.settings)
# OpenAI key: Admin → Settings → openai_api_key

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d
ADMIN_SESSION_SECRET=change_this_admin_session_secret
# Idle logout after last action (ms). Default 1 hour.
ADMIN_SESSION_IDLE_MS=3600000
# Absolute max session lifetime (ms). Default 8 hours.
ADMIN_SESSION_MAX_MS=28800000
# bcrypt cost (salt auto-generated per password). Default 12.
BCRYPT_ROUNDS=12
# Force Secure cookie flag. Auto: follow request (HTTP=false, HTTPS=true).
# COOKIE_SECURE=true
# COOKIE_SECURE=false
# Optional API CORS allowlist (comma-separated). Empty = allow all origins for Bearer API.
# CORS_ORIGIN=https://app.example.com

DB_SERVER=10.44.200.72
DB_USER=sa
DB_PASSWORD=your_db_password_here
DB_DATABASE=db_lpdp_ai
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

MAX_UPLOAD_MB=10
